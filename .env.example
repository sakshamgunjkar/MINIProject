# SmartCommute Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcommute_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Direct Database URL (Optional if individual parameters are supplied)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/smartcommute_db

# Flask Application Secret & Environment
SECRET_KEY=smartcommute_production_secret_key_change_in_prod
FLASK_ENV=production
FLASK_DEBUG=0
